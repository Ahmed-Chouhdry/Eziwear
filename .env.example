# Copy to .env for docker-compose + backend
# Host port 3307 (3306 is often taken by another local MySQL)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=eziwear
DB_USER=eziwear
DB_PASSWORD=eziwear
DB_ROOT_PASSWORD=eziroot
ADMINER_PORT=8081

# Backend
PORT=3005
NODE_ENV=development
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:4200,http://localhost:4310

# Rate limiting — keep AUTH low in production (brute-force protection); raise for local testing
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Cloudinary (Phase 15 / product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
